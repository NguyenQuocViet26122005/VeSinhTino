# Server-only. Generate a NEW token in BotFather; never reuse the exposed token.
# Configure these in your hosting dashboard. Never prefix with PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public GA4 measurement ID (G-...). Set on Vercel Production before building.
PUBLIC_GA_MEASUREMENT_ID=G-824Z7LYPZ5

# Second private account receives form notifications and can request reports.
TELEGRAM_REPORT_CHAT_ID_2=
# Server-only reporting configuration. Existing bot and first recipient are reused.
GA4_PROPERTY_ID=394527770
GA4_CLIENT_EMAIL=tino-analytics-reporter@tino-analytics.iam.gserviceaccount.com
GA4_PRIVATE_KEY=
# Random secret, at least 32 characters, passed to Telegram setWebhook as secret_token.
TELEGRAM_WEBHOOK_SECRET=
