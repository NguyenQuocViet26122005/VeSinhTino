---
// Only the public measurement ID is embedded. Reporting credentials stay server-only.
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();
const enabled = import.meta.env.PROD && /^G-[A-Z0-9]+$/.test(measurementId || '');
---
{enabled && <meta name="tino-ga-id" content={measurementId} />}
<script>
  type AnalyticsWindow = Window & {
    dataLayer?: unknown[];
    gtag?: (...args: unknown[]) => void;
  };
  const analyticsWindow = window as AnalyticsWindow;
  let initialized = false;
  let previousPage = '';
  let conversionListenersAttached = false;
  let activeMeasurementId = '';
  let currentReferrer = '';

  // Store landing campaign parameters in-memory across the client session
  // to ensure ads attribution is maintained on subsequent page transitions.
  const landingCampaignParams = new URLSearchParams();
  const ALLOWED_CAMPAIGN_KEYS = [
    'utm_source', 'utm_medium', 'utm_campaign', 'utm_id', 'utm_term', 'utm_content',
    'gclid', 'dclid', 'gbraid', 'wbraid', 'gclsrc', 'gad_source', 'gad_campaignid'
  ];

  // Capture campaign params from initial landing URL once
  if (typeof location !== 'undefined' && location.search) {
    try {
      const initialParams = new URLSearchParams(location.search);
      for (const key of ALLOWED_CAMPAIGN_KEYS) {
        const item = initialParams.get(key);
        if (item) landingCampaignParams.set(key, item.slice(0, 512));
      }
    } catch { /* ignore malformed query */ }
  }

  // Campaign parameters belong to the current Tino page, never to its referrer.
  // Preserves allowed campaign params without leaking arbitrary query params or fragments.
  function getSafePageLocation(): string {
    const url = new URL(location.href);
    const clean = new URL(url.origin + url.pathname);
    // Prefer current URL's allowed params, fallback to session landing params
    const currentParams = url.searchParams;
    let hasCurrentCampaign = false;
    for (const key of ALLOWED_CAMPAIGN_KEYS) {
      if (currentParams.has(key)) {
        hasCurrentCampaign = true;
        break;
      }
    }
    const sourceParams = hasCurrentCampaign ? currentParams : landingCampaignParams;
    for (const key of ALLOWED_CAMPAIGN_KEYS) {
      const item = sourceParams.get(key);
      if (item) clean.searchParams.set(key, item.slice(0, 512));
    }
    return clean.href;
  }

  function getSafeReferrer(rawUrl: string): string {
    const url = new URL(rawUrl);
    if (!['http:', 'https:'].includes(url.protocol)) return '';
    return url.origin + url.pathname;
  }

  const knownServices = new Set([
    'Tổng vệ sinh nhà sau xây dựng', 'Tổng vệ sinh chung cư trọn gói',
    'Vệ sinh nhà ở & Nhà cũ', 'Vệ sinh kho & Nhà xưởng',
    'Vệ sinh kính tòa nhà cao tầng', 'Giặt ghế sofa & Nệm tại nhà',
    'Giặt thảm văn phòng'
  ]);

  function setupConversionTracking(id: string) {
    activeMeasurementId = id;
    if (conversionListenersAttached) return;
    conversionListenersAttached = true;

    document.addEventListener('click', (e) => {
      const clicked = e.target as Element | null;
      const target = typeof clicked?.closest === 'function' ? clicked.closest('a') : null;
      if (!target || !target.href || !analyticsWindow.gtag || !activeMeasurementId) return;
      const href = target.href.trim();
      const currentPageLocation = getSafePageLocation();

      if (href.startsWith('tel:')) {
        analyticsWindow.gtag('event', 'click_hotline', {
          send_to: activeMeasurementId,
          event_category: 'conversion',
          transport_type: 'beacon',
          page_location: currentPageLocation,
          page_referrer: currentReferrer
        });
      } else if (target.protocol === 'https:' && target.hostname === 'zalo.me') {
        analyticsWindow.gtag('event', 'click_zalo', {
          send_to: activeMeasurementId,
          event_category: 'conversion',
          transport_type: 'beacon',
          page_location: currentPageLocation,
          page_referrer: currentReferrer
        });
      }
    });

    window.addEventListener('tino:lead-success', (e: Event) => {
      if (!analyticsWindow.gtag || !activeMeasurementId) return;
      const customEvent = e as CustomEvent<{ service?: string }>;
      const serviceCategory = typeof customEvent.detail?.service === 'string' && knownServices.has(customEvent.detail.service)
        ? customEvent.detail.service
        : 'general';
      const currentPageLocation = getSafePageLocation();

      analyticsWindow.gtag('event', 'generate_lead', {
        send_to: activeMeasurementId,
        event_category: 'conversion',
        service_category: serviceCategory,
        page_location: currentPageLocation,
        page_referrer: currentReferrer
      });
    });
  }

  document.addEventListener('astro:page-load', () => {
    const id = document.querySelector<HTMLMetaElement>('meta[name="tino-ga-id"]')?.content;
    if (!id || !['vesinhtino.com', 'www.vesinhtino.com'].includes(location.hostname)) return;
    const page = getSafePageLocation();
    let referrer = previousPage;
    if (!referrer && document.referrer) {
      try { referrer = getSafeReferrer(document.referrer); } catch { /* no referrer */ }
    }
    currentReferrer = referrer;
    if (!initialized) {
      analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
      if (!analyticsWindow.gtag) {
        analyticsWindow.gtag = function () { analyticsWindow.dataLayer!.push(arguments); };
        analyticsWindow.gtag('js', new Date());
      }
      analyticsWindow.gtag('config', id, {
        send_page_view: false, allow_google_signals: false,
        page_location: page, page_referrer: referrer
      });
      if (!document.querySelector('script[src^="https://www.googletagmanager.com/gtag/js"]')) {
        const injectScript = () => {
          if (document.querySelector('script[src^="https://www.googletagmanager.com/gtag/js"]')) return;
          const script = document.createElement('script');
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`;
          document.head.append(script);
        };

        if (typeof window !== 'undefined' && typeof (window as any).requestIdleCallback === 'function') {
          (window as any).requestIdleCallback(injectScript, { timeout: 1500 });
        } else if (typeof setTimeout === 'function') {
          setTimeout(injectScript, 500);
        } else {
          injectScript();
        }

        const onInteraction = () => {
          ['pointerdown', 'touchstart', 'scroll', 'keydown'].forEach(evt => {
            window.removeEventListener(evt, onInteraction, { capture: true });
          });
          injectScript();
        };
        if (typeof window !== 'undefined' && typeof window.addEventListener === 'function') {
          ['pointerdown', 'touchstart', 'scroll', 'keydown'].forEach(evt => {
            window.addEventListener(evt, onInteraction, { capture: true, passive: true, once: true });
          });
        }
      }
      initialized = true;
    }
    setupConversionTracking(id);
    // Route this manual event only to this Analytics stream, not other Ads tags.
    analyticsWindow.gtag!('event', 'page_view', {
      send_to: id, page_location: page, page_title: document.title, page_referrer: referrer
    });
    previousPage = getSafeReferrer(location.href);
  });
</script>
