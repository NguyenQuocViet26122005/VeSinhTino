---
import { image } from '../data/site';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

interface ServiceCardItem {
  slug: string;
  name: string;
  tag: string;
  description: string;
  priceHighlight: string;
  photo: string;
  href: string;
}

interface ServiceCategoryGroup {
  id: string;
  title: string;
  subtitle: string;
  badge: string;
  items: ServiceCardItem[];
}

const serviceCategoryGroups: ServiceCategoryGroup[] = [
  {
    id: 'nha-o-can-ho',
    title: 'Nhóm Dịch vụ Căn hộ & Nhà ở',
    subtitle: 'Giải pháp làm sạch toàn diện cho căn hộ chung cư, nhà phố và công trình sau xây dựng đón tân gia.',
    badge: 'TỔ ẤM & CĂN HỘ',
    items: [
      {
        slug: 'dich-vu-ve-sinh-cong-nghiep',
        name: 'Tổng vệ sinh nhà sau xây dựng',
        tag: 'Sau thi công',
        description: 'Làm sạch tổng thể sau thi công, sủi sơn xi măng, đánh sàn máy mâm xoay và hoàn thiện bàn giao.',
        priceHighlight: 'Từ 12.000 – 20.000 đ/m²',
        photo: 'b486da45979bde972f03edd7f9a890e5',
        href: '/dich-vu-ve-sinh-cong-nghiep/'
      },
      {
        slug: 've-sinh-chung-cu',
        name: 'Tổng vệ sinh chung cư trọn gói',
        tag: 'Gói căn hộ chuyên sâu',
        description: 'Vệ sinh chuyên sâu cho căn hộ 1PN, 2PN, 3PN với đơn giá chuẩn 30k/m², gói 50m² từ 1tr6. Ảnh thực tế tại Bình Chánh.',
        priceHighlight: '30.000 đ/m² (50m² từ 1.6tr)',
        photo: 'tino-chung-cu-binh-chanh',
        href: '/ve-sinh-nha-o/#goi-ve-sinh-chung-cu'
      },
      {
        slug: 've-sinh-nha-o',
        name: 'Vệ sinh nhà ở & Nhà cũ',
        tag: 'Chăm chút tổ ấm',
        description: 'Tổng vệ sinh nhà phố, biệt thự định kỳ hoặc làm sạch sâu trước khi gia đình dọn vào nhà cũ.',
        priceHighlight: 'Từ 10.000 – 20.000 đ/m²',
        photo: 'f3e9578413dffb6cd7a69149858785c1',
        href: '/ve-sinh-nha-o/'
      }
    ]
  },
  {
    id: 'doanh-nghiep-kho-xuong',
    title: 'Nhóm Doanh nghiệp & Công nghiệp',
    subtitle: 'Đáp ứng quy mô diện tích lớn, đảm bảo tiến độ và tiêu chuẩn an toàn kỹ thuật cao nhất.',
    badge: 'DOANH NGHIỆP & NHÀ XƯỞNG',
    items: [
      {
        slug: 've-sinh-nha-xuong',
        name: 'Vệ sinh kho & Nhà xưởng',
        tag: 'Không gian sản xuất',
        description: 'Vệ sinh kho bãi, quét bụi xà gồ trần xưởng và tẩy rửa dầu mỡ sàn bê tông, sàn epoxy công nghiệp.',
        priceHighlight: 'Từ 6.000 – 15.000 đ/m²',
        photo: 'e6ecb611e10bc770',
        href: '/ve-sinh-nha-xuong/'
      },
      {
        slug: 've-sinh-kinh-toa-nha',
        name: 'Vệ sinh kính tòa nhà cao tầng',
        tag: 'Trong hơn, sáng hơn',
        description: 'Thi công đu dây mặt ngoài, giàn giáo và xe nâng người mặt dựng kính cao ốc an toàn chuẩn kỹ thuật.',
        priceHighlight: 'Từ 12.000 – 30.000 đ/m²',
        photo: 'c949d223bc44f1ae',
        href: '/ve-sinh-kinh-toa-nha/'
      }
    ]
  },
  {
    id: 'noi-that-tien-ich',
    title: 'Nhóm Tiện ích & Chăm sóc nội thất',
    subtitle: 'Chăm sóc chuyên sâu các bề mặt vải, nệm, sofa và thảm bằng công nghệ phun hút sinh học an toàn.',
    badge: 'TIỆN ÍCH NỘI THẤT',
    items: [
      {
        slug: 'dich-vu-giat-ghe-sofa',
        name: 'Giặt ghế sofa & Nệm tại nhà',
        tag: 'Êm ái mỗi ngày',
