        photo: 'e20602f023e8669e',
        href: '/dich-vu-giat-tham/'
      }
    ]
  }
];
---

<div class={`service-directory-wrapper ${compact ? 'is-compact' : ''}`}>
  <!-- Category Fast Jump Nav -->
  <nav class="service-category-nav" aria-label="Phân nhóm danh mục dịch vụ">
    <span class="category-nav-label">Phân nhóm dịch vụ:</span>
    <div class="category-nav-links">
      {serviceCategoryGroups.map((group, idx) => (
        <a href={`#${group.id}`} class="category-nav-pill">
          <span class="pill-num">0{idx + 1}</span>
          <span>{group.title.replace('Nhóm Dịch vụ ', '').replace('Nhóm ', '')}</span>
        </a>
      ))}
    </div>
  </nav>

  <div class="service-groups-stack">
    {serviceCategoryGroups.map((group) => (
      <section class="service-group-block" id={group.id}>
        <div class="group-header">
          <span class="group-badge">{group.badge}</span>
          <h2 class="group-title">{group.title}</h2>
          <p class="group-subtitle">{group.subtitle}</p>
        </div>

        <div class="service-list">
          {group.items.map((s) => (
            <a class="service-card" href={s.href}>
              <div class="service-photo">
                <img
                  src={s.photo.startsWith('tino-') ? `/images/${s.photo}.webp` : image(s.photo)}
                  alt={s.name}
                  loading="lazy"
                  decoding="async"
                  width="768"
                  height="640"
                />
                <span class="round-arrow" aria-hidden="true">↗</span>
              </div>
              <div class="service-copy">
                <div class="service-meta-row">
                  <span class="service-tag">{s.tag}</span>
                  <span class="service-price-chip">{s.priceHighlight}</span>
                </div>
                <h3>{s.name}</h3>
                <p>{s.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</div>

<style>
  .service-directory-wrapper {
    margin-bottom: 40px;
  }
  .service-category-nav {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    background: #f1f7fb;
    border: 1px solid rgba(15, 41, 66, 0.08);
    border-radius: 12px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }
  .category-nav-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--brand, #0f2942);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .category-nav-links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .category-nav-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: #ffffff;
    border: 1px solid rgba(15, 41, 66, 0.12);
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--brand, #0f2942);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .category-nav-pill:hover {
    background: #0872af;
    color: #ffffff;
    border-color: #0872af;
  }
  .pill-num {
    font-size: 11px;
    opacity: 0.7;
    font-family: var(--display, 'Manrope', sans-serif);
  }
  .service-group-block {
    margin-bottom: 60px;
    scroll-margin-top: 100px;
  }
  .group-header {
    margin-bottom: 24px;
    border-bottom: 1px solid rgba(15, 41, 66, 0.08);
    padding-bottom: 16px;
  }
  .group-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #0872af;
    background: rgba(8, 114, 175, 0.08);
    padding: 3px 10px;
    border-radius: 4px;
    margin-bottom: 8px;
  }
  .group-title {
    font-size: 24px;
    font-weight: 700;
    color: var(--brand, #0f2942);
    margin: 0 0 6px;
  }
  .group-subtitle {
    font-size: 14.5px;
    color: var(--muted, #475569);
    margin: 0;
  }
  .service-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .service-price-chip {
    font-size: 12px;
    font-weight: 700;
    color: #0872af;
    background: rgba(8, 114, 175, 0.08);
    padding: 2px 8px;
    border-radius: 4px;
  }
  @media (max-width: 768px) {
    .service-category-nav {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .group-title {
      font-size: 20px;
    }
  }
</style>
