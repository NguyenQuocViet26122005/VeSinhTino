---
import Layout from '../layouts/Layout.astro';
import '../styles/interior.css';
import PriceTable from '../components/PriceTable.astro';
import ContactBand from '../components/ContactBand.astro';
import ServiceList from '../components/ServiceList.astro';
import TrustCards from '../components/TrustCards';
import {
  services,
  articles,
  articleReferences,
  image,
  contact,
  commonPrices,
  apartmentPrices,
  factoryPrices,
  glassPrices,
  steps
} from '../data/site';
import {
  buildCanonicalUrl,
  getServiceSchema,
  getArticleSchema,
  getBreadcrumbSchema,
  SITE_URL
} from '../lib/seo-schema';
import { responsiveImagesOrOriginal } from '../lib/responsive-images';

export function getStaticPaths() {
  return [
    ...services.map((s) => ({ params: { slug: s.slug }, props: { kind: 'service', slug: s.slug } })),
    ...articles.map((a) => ({ params: { slug: a.slug }, props: { kind: 'article', slug: a.slug } })),
    ...[
      'gioi-thieu',
      'bang-gia',
      'tin-tuc',
      'cam-nang',
      'lien-he',
      'tuyen-dung',
      'category/dichvuvesinh',
      'category/dich-vu-phu',
      'author/vesinhtinogmail-com'
    ].map((slug) => ({ params: { slug }, props: { kind: 'page', slug } }))
  ];
}

const { slug } = Astro.props;
const service = services.find((s) => s.slug === slug);
const article = articles.find((a) => a.slug === slug);

const isJournal = ['tin-tuc', 'cam-nang', 'category/dich-vu-phu', 'author/vesinhtinogmail-com'].includes(slug);
// Same article list as /cam-nang/. Vercel 301-redirects these (vercel.json); elsewhere they stay out of the index.
const isJournalAlias = isJournal && slug !== 'cam-nang';

// Resized WebP renditions for every photo this page shows; the photo dialog keeps the original.
const pagePhotoIds = [
  ...(service ? [service.photo, ...service.photos] : []),
  ...(article ? [article.photo] : []),
  ...(isJournal ? articles.map((a) => a.photo) : []),
  ...(slug === 'gioi-thieu' ? ['f073dd95d8ed1766', '7feaeec9c23f86043f45177ee81d9896', 'b486da45979bde972f03edd7f9a890e5'] : []),
  ...(slug === 'tuyen-dung' ? ['3799e45e26386034'] : [])
];
const photos = await responsiveImagesOrOriginal(pagePhotoIds.map((id) => image(id)));
const photo = (id: string) => photos[image(id)] ?? { src: image(id), srcSet: '' };
const wideSizes = '(max-width: 700px) calc(100vw - 40px), (max-width: 1000px) 45vw, 600px';

let title = 'Vệ Sinh Tino';
let description = 'Dịch vụ vệ sinh Tino tại TP.HCM: vệ sinh nhà ở, công nghiệp, nhà xưởng, kính, giặt thảm và sofa. Xem bảng giá và liên hệ 0925 649 666.';
let pageSchema: any[] = [];
let ogImage = `${SITE_URL}/images/3b21a7ec444d0b39.webp`;

if (service) {
  title = `${service.name} tại TP.HCM - Báo giá & Khảo sát`;
  // Kept near 155 characters so Google shows the price and phone number instead of cutting them off.
  // commonPrices mixes several services; for that list only its first row (sau xây dựng) describes this page.
  const priced = (service.prices === commonPrices ? commonPrices.slice(0, 1) : service.prices || [])
    .map((row) => ({ value: Number(row.price.replace(/^Từ\s+/i, '').split(/[–-]/)[0].replace(/\./g, '')), row }))
    .filter((item) => Number.isFinite(item.value) && item.value > 0)
    .sort((x, y) => x.value - y.value)[0];
  const priceText = priced ? ` giá từ ${priced.value.toLocaleString('vi-VN')}đ/${priced.row.unit.toLowerCase()}` : '';
  description = `${service.name} tại TP.HCM${priceText}. Khảo sát & báo giá theo hiện trạng, nghiệm thu rồi mới thanh toán. Hotline/Zalo ${contact.display}.`;
  ogImage = `${SITE_URL}/images/${service.photo}.webp`;
  const breadcrumbs = [
    { name: 'Trang chủ', url: '/' },
    { name: 'Dịch vụ', url: '/category/dichvuvesinh/' },
    { name: service.name, url: `/${service.slug}/` }
  ];
  pageSchema = [
    getBreadcrumbSchema(breadcrumbs),
    getServiceSchema(service.name, service.description, buildCanonicalUrl(Astro.url.pathname), service.prices)
  ];
} else if (article) {
  title = article.title;
  description = article.lead;
  ogImage = `${SITE_URL}/images/${article.photo}.webp`;
  const breadcrumbs = [
    { name: 'Trang chủ', url: '/' },
    { name: 'Cẩm nang', url: '/cam-nang/' },
    { name: article.title, url: `/${article.slug}/` }
  ];
  pageSchema = [
    getBreadcrumbSchema(breadcrumbs),
    getArticleSchema(article.title, article.lead, buildCanonicalUrl(Astro.url.pathname), article.photo)
  ];
} else {
  const titles: Record<string, string> = {
    'gioi-thieu': 'Về Vệ Sinh Tino - Đội ngũ vệ sinh tận tâm tại TP.HCM',
    'bang-gia': 'Bảng giá dịch vụ vệ sinh công nghiệp & nhà ở 2026',
    'tin-tuc': 'Chuyện chăm nhà & Cẩm nang vệ sinh',
    'cam-nang': 'Cẩm nang vệ sinh nhà cửa & công nghiệp',
    'lien-he': 'Liên hệ Vệ Sinh Tino - Khảo sát & Báo giá tại TP.HCM',
    'tuyen-dung': 'Tuyển dụng nhân viên vệ sinh tại TP.HCM',
    'category/dichvuvesinh': 'Dịch vụ vệ sinh nhà ở & công nghiệp chuyên nghiệp',
    'category/dich-vu-phu': 'Kinh nghiệm vệ sinh nhà cửa & văn phòng',
    'author/vesinhtinogmail-com': 'Bài viết từ Vệ Sinh Tino'
  };
  const descriptions: Record<string, string> = {
    'gioi-thieu': 'Dịch vụ vệ sinh nhà ở, căn hộ và công trình tại TP.HCM. Đội ngũ chăm sóc chu đáo, trang thiết bị chuyên dụng và hóa chất làm sạch phù hợp.',
    'bang-gia': 'Bảng giá chi tiết dịch vụ vệ sinh công nghiệp từ 12.000đ/m², căn hộ chung cư từ 1.600.000đ, nhà xưởng, lau kính, giặt ghế sofa và thảm tại TP.HCM.',
    'tin-tuc': 'Kinh nghiệm dọn dẹp nhà cửa, chuẩn bị vệ sinh sau xây dựng và lưu ý chăm sóc đồ nội thất do Vệ Sinh Tino tổng hợp.',
    'cam-nang': 'Tổng hợp các bài viết hướng dẫn vệ sinh công trình sau xây dựng, chuẩn bị mặt bằng và mẹo làm sạch nhà cửa an toàn.',
    'lien-he': 'Liên hệ Vệ Sinh Tino: Hotline 0925 649 666. Ba địa chỉ phục vụ tại Quận 12 (557 Tô Ký), Phú Nhuận (151 Nguyễn Đình Chính), Quận 7 (37B Nguyễn Văn Linh).',
    'tuyen-dung': 'Tuyển dụng kỹ thuật viên vệ sinh công nghiệp và vệ sinh nhà ở tại TP.HCM. Thu nhập ổn định, môi trường làm việc chu đáo, đào tạo tận tình.',
    'category/dichvuvesinh': 'Tổng hợp các dịch vụ vệ sinh hàng đầu của Tino: Vệ sinh sau xây dựng, nhà ở, nhà xưởng, kính tòa nhà, giặt thảm và ghế sofa tại TP.HCM.',
    'category/dich-vu-phu': 'Các mẹo chăm sóc không gian sống, tẩy mốc và kinh nghiệm vệ sinh đồ nội thất an toàn, tiết kiệm.',
    'author/vesinhtinogmail-com': 'Các bài viết và lưu ý vệ sinh nhà cửa, công trình do Vệ Sinh Tino tổng hợp.'
  };
  title = titles[slug] || 'Vệ Sinh Tino';
  description = descriptions[slug] || description;
  const pageName =
    slug === 'bang-gia'
      ? 'Bảng giá'
      : slug === 'lien-he'
      ? 'Liên hệ'
      : slug === 'gioi-thieu'
      ? 'Về Tino'
      : isJournal
      ? 'Cẩm nang'
      : slug === 'tuyen-dung'
      ? 'Tuyển dụng'
      : 'Dịch vụ';
  const breadcrumbs = [
    { name: 'Trang chủ', url: '/' },
    { name: pageName, url: `/${slug}/` }
  ];
  pageSchema = [getBreadcrumbSchema(breadcrumbs)];
}
---
<Layout title={title} description={description} schema={pageSchema} ogImage={ogImage} alias={isJournalAlias}>
  {service ? (
    <>
      <section class="container service-hero">
        <div>
          <nav class="breadcrumbs" aria-label="Đường dẫn">
            <a href="/">Trang chủ</a>
            <span>/</span>
            <a href="/category/dichvuvesinh/">Dịch vụ</a>
          </nav>
          <p class="page-kicker">TINO / {service.tag}</p>
          <h1>{service.name}</h1>
          <p>{service.description}</p>
          <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:20px;">
            <a class="button" href={'tel:' + contact.phone}>
              Hotline: {contact.display} <span aria-hidden="true">↗</span>
            </a>
            <a class="button light" href={contact.zalo} target="_blank" rel="noopener noreferrer">
              Tư vấn Zalo nhanh <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <img
          src={photo(service.photo).src}
          srcset={photo(service.photo).srcSet || undefined}
          sizes={wideSizes}
          alt={service.name}
          width="768"
          height="850"
          fetchpriority="high"
          decoding="async"
        />
      </section>

      <section class="container section service-body">
        <article>
          <p class="page-kicker">01 / HẠNG MỤC THỰC HIỆN</p>
          <h2>Chăm sóc đúng cách &amp; Đối tượng phù hợp</h2>
          <p>{service.intro}</p>

          {service.suitableFor && (
            <div class="service-suitable-box">
              <strong>Đối tượng phù hợp:</strong> {service.suitableFor}
            </div>
          )}

          <ul class="task-list">
            {service.tasks.map((task) => (
              <li>{task}</li>
            ))}
          </ul>

          <p class="page-kicker">02 / CHI PHÍ MINH BẠCH</p>
          <h2>Đơn giá dịch vụ</h2>
          <PriceTable rows={service.prices} caption={'Bảng giá ' + service.name.toLowerCase()} />
          <p class="price-note">{service.priceNote} Chi phí cụ thể được thống nhất sau khi khảo sát hiện trạng và xác định phạm vi công việc.</p>

          {service.scopeStandard && service.scopeCustom && (
            <>
              <p class="page-kicker">03 / PHẠM VI CÔNG VIỆC</p>
              <h2>Hạng mục tiêu chuẩn &amp; Thỏa thuận riêng</h2>
              <div class="scope-comparison-grid">
                <div class="scope-box">
                  <h3>Gói tiêu chuẩn bao gồm</h3>
                  <ul>
                    {service.scopeStandard.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
                <div class="scope-box custom">
                  <h3>Hạng mục khảo sát / Thỏa thuận riêng</h3>
                  <ul>
                    {service.scopeCustom.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </>
          )}

          {service.quoteGuide && (
            <div class="local-service-box">
              <p class="page-kicker" style="margin-bottom:8px!important;">04 / KHẢO SÁT &amp; KHU VỰC PHỤC VỤ</p>
              <h3 style="font-size:20px;font-weight:600;margin-bottom:12px;color:var(--green-dark);">Khu vực phục vụ tại TP.HCM &amp; Cách nhận báo giá</h3>
              <p>{service.quoteGuide}</p>
              <div class="local-hubs-list">
                <div class="local-hub-item">
                  <strong>Quận 12 &amp; Bắc Sài Gòn</strong>
                  <span>557 Tô Ký, P. Trung Mỹ Tây (Phục vụ Q12, Hóc Môn, Gò Vấp, Tân Bình)</span>
                </div>
                <div class="local-hub-item">
                  <strong>Phú Nhuận &amp; Trung tâm</strong>
                  <span>151 Nguyễn Đình Chính, P. 11 (Phục vụ Phú Nhuận, Q1, Q3, Bình Thạnh)</span>
                </div>
                <div class="local-hub-item">
                  <strong>Quận 7 &amp; Nam Sài Gòn</strong>
                  <span>37B Nguyễn Văn Linh, P. Tân Thuận Tây (Phục vụ Q7, Nhà Bè, Q4, Q8)</span>
                </div>
              </div>
            </div>
          )}

          <div class="service-gallery">
            {service.photos.map((id) => (
              <button
                data-photo={image(id)}
                data-caption={service.name}
                aria-label={'Xem ảnh ' + service.name.toLowerCase()}
              >
                <img
                  src={photo(id).src}
                  srcset={photo(id).srcSet || undefined}
                  sizes="(max-width: 700px) 45vw, 260px"
                  alt={service.name}
                  loading="lazy"
                  decoding="async"
                  width="768"
                  height="850"
                />
              </button>
            ))}
          </div>
        </article>

        <aside class="service-sidebar">
          <h2>Dịch vụ của Tino</h2>
          {services.map((s) => (
            <a href={'/' + s.slug + '/'} aria-current={s.slug === slug ? 'page' : undefined}>
              {s.name} ↗
            </a>
          ))}
          <a class="button" href="/bang-gia/">
            Xem tất cả bảng giá
          </a>
          <div style="margin-top:28px;padding-top:20px;border-top:1px solid #ffffff25;">
            <p style="font-size:13px;color:#c4dfed;margin-bottom:10px;">Cần tư vấn trực tiếp?</p>
            <a href={'tel:' + contact.phone} style="color:#a9e7f5;font-weight:600;font-size:16px;">
              Hotline: {contact.display} ↗
            </a>
          </div>
        </aside>
      </section>

      <section class="container section related-section">
        <div class="section-heading">
          <h2>Rõ ràng từng bước.</h2>
        </div>
        <ol class="process-list">
          {steps.map(([n, t, d]) => (
            <li>
              <span class="step-circle">{n}</span>
              <h3>{t}</h3>
              <p>{d}</p>
            </li>
          ))}
        </ol>
      </section>

      <ContactBand />
    </>
  ) : article ? (
    <>
      <section class="container page-intro">
        <nav class="breadcrumbs" aria-label="Đường dẫn">
          <a href="/">Trang chủ</a>
          <span>/</span>
          <a href="/cam-nang/">Cẩm nang</a>
        </nav>
        <p class="article-meta">{article.category} · Vệ Sinh Tino</p>
        <h1>{article.title}</h1>
        <p>{article.lead}</p>
      </section>

      <div class="read-progress" aria-hidden="true"></div>
      <article class="container article-layout">
        <div>
          <nav class="article-toc" aria-label="Nội dung bài viết">
            <strong>TRONG BÀI VIẾT NÀY</strong>
            {article.sections.map(([heading], i) => (
              <a href={'#noi-dung-' + i}>
                {heading}
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </nav>

          {article.sections.map(([heading, body], i) => (
            <section id={'noi-dung-' + i}>
              <h2>{heading}</h2>
              <p>{body}</p>
            </section>
          ))}

          {articleReferences[article.slug]?.length > 0 && (
            <aside class="article-related-box" aria-label="Nguồn hướng dẫn tham khảo">
              <h3>Nguồn hướng dẫn tham khảo</h3>
              <div class="article-related-links">
                {articleReferences[article.slug].map((reference) => (
                  <a href={reference.url} target="_blank" rel="noopener noreferrer">{reference.name} ↗</a>
                ))}
              </div>
            </aside>
          )}

          <div class="article-related-box">
            <h3>Liên kết &amp; Dịch vụ liên quan</h3>
            <div class="article-related-links">
              {article.slug.includes('cong-nghiep') || article.slug.includes('xay-dung') ? (
                <a href="/dich-vu-ve-sinh-cong-nghiep/">
                  → Tham khảo dịch vụ Vệ sinh công nghiệp &amp; Sau xây dựng trọn gói
                </a>
              ) : (
                <a href="/ve-sinh-nha-o/">
                  → Tham khảo dịch vụ Tổng vệ sinh nhà ở &amp; Căn hộ chung cư
                </a>
              )}
              <a href="/bang-gia/">
                → Xem toàn bộ bảng giá dịch vụ vệ sinh Tino niêm yết
              </a>
              <a href="/lien-he/">
                → Đặt lịch khảo sát tận nơi hoặc gửi ảnh qua Zalo 0925 649 666
              </a>
            </div>
          </div>

          <p class="article-meta" style="margin-top:30px;">
            Thông tin do Vệ Sinh Tino tổng hợp. Phương án thực tế cần trao đổi theo chất liệu và hiện trạng.
          </p>
        </div>

        <img
          src={photo(article.photo).src}
          srcset={photo(article.photo).srcSet || undefined}
          sizes={wideSizes}
          alt={article.title}
          width="768"
          height="1024"
          fetchpriority="high"
          decoding="async"
        />
      </article>

      <ContactBand />
    </>
  ) : (
    <>
      <section class="container page-intro">
        <nav class="breadcrumbs" aria-label="Đường dẫn">
          <a href="/">Trang chủ</a>
          <span>/</span>
          <span>
            {slug === 'bang-gia'
              ? 'Bảng giá'
              : slug === 'lien-he'
              ? 'Liên hệ'
              : slug === 'gioi-thieu'
              ? 'Về Tino'
              : isJournal
              ? 'Cẩm nang'
              : slug === 'tuyen-dung'
              ? 'Tuyển dụng'
              : 'Dịch vụ'}
          </span>
        </nav>
        <p class="page-kicker">
          TINO /{' '}
          {slug === 'gioi-thieu'
            ? 'CÂU CHUYỆN CỦA CHÚNG TÔI'
            : slug === 'lien-he'
            ? 'BẮT ĐẦU CUỘC TRÒ CHUYỆN'
            : slug === 'bang-gia'
            ? 'CHI PHÍ MINH BẠCH'
            : isJournal
            ? 'CẨM NANG CHĂM NHÀ'
            : slug === 'tuyen-dung'
            ? 'CÙNG NHAU LÀM TỐT'
            : 'CHĂM SÓC KHÔNG GIAN'}
        </p>
        <h1>{title}</h1>
        {slug === 'bang-gia' && (
          <p>
            Đơn giá chi tiết theo từng hạng mục, diện tích và phương pháp thi công. Tino trao đổi hiện trạng và thống nhất phạm vi công việc cùng chi phí trước khi thực hiện.
          </p>
        )}
        {slug === 'category/dichvuvesinh' && (
          <p>Từ tổ ấm gia đình đến không gian làm việc, chọn phương án chăm sóc phù hợp với hiện trạng.</p>
        )}
        {isJournal && (
          <p>Những lưu ý thiết thực để chăm sóc nhà cửa, chuẩn bị cho một buổi vệ sinh hiệu quả và tiết kiệm chi phí.</p>
        )}
        {slug === 'lien-he' && (
          <p>
            Cho Tino biết diện tích, địa chỉ, hiện trạng và thời gian bạn cần hỗ trợ. Kỹ thuật viên sẽ tư vấn phương án phù hợp hoặc trao đổi lịch hẹn khảo sát thực tế.
          </p>
        )}
        {slug === 'gioi-thieu' && (
          <p>
            Đồng hành cùng các gia đình, văn phòng và công trình tại TP.HCM với tinh thần tận tâm, kỷ luật và chu đáo trong từng chi tiết.
          </p>
        )}
      </section>

      {slug === 'bang-gia' && (
        <div class="container">
          <nav class="price-jump" aria-label="Chọn bảng giá">
            <a href="#gia-tong-hop">01 / Tổng hợp</a>
            <a href="#gia-chung-cu">02 / Gói chung cư</a>
            <a href="#gia-nha-xuong">03 / Nhà xưởng</a>
            <a href="#gia-kinh">04 / Kính tòa nhà</a>
          </nav>
          <section id="gia-tong-hop" class="price-block">
            <h2>Vệ sinh tổng hợp</h2>
            <PriceTable rows={commonPrices} caption="Đơn giá theo hạng mục" />
          </section>
          <section id="gia-chung-cu" class="price-block">
            <h2>Tổng vệ sinh chung cư trọn gói</h2>
            <PriceTable rows={apartmentPrices} caption="Bảng giá vệ sinh chung cư trọn gói" />
            <p class="price-note">
              Gói tổng vệ sinh chung cư trọn gói căn 50m² từ 1.600.000 đ. Đơn giá tham khảo đã bao gồm nhân công, máy móc thiết bị chuyên dụng và hóa chất làm sạch phù hợp. Chi phí cụ thể được thống nhất rõ ràng trước khi thực hiện.
            </p>
          </section>
          <section id="gia-nha-xuong" class="price-block">
            <h2>Vệ sinh nhà xưởng</h2>
            <PriceTable rows={factoryPrices} caption="Đơn giá theo diện tích nhà xưởng" />
          </section>
          <section id="gia-kinh" class="price-block">
            <h2>Vệ sinh kính tòa nhà</h2>
            <PriceTable rows={glassPrices} caption="Đơn giá theo phương pháp thi công" />
            <p class="price-note">
              Kính ngoài cao tầng ở bảng tổng hợp ghi “Liên hệ”. Các mức trên là bảng riêng theo phương pháp thi công, không áp dụng đồng loạt cho mọi công trình.
            </p>
          </section>
        </div>
      )}

      {slug === 'category/dichvuvesinh' && (
        <section class="container section">
          <ServiceList compact />
        </section>
      )}

      {isJournal && (
        <section class="container section article-journal">
          <div class="journal-grid">
            {articles.map((a) => (
              <a href={'/' + a.slug + '/'} class="journal-card">
                <img
                  src={photo(a.photo).src}
                  srcset={photo(a.photo).srcSet || undefined}
                  sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1000px) 45vw, 420px"
                  alt={a.title}
                  loading="lazy"
                  decoding="async"
                  width="768"
                  height="520"
                />
                <span>{a.category}</span>
                <h2 style="font-size:23px;margin:10px 0">{a.title}</h2>
                <span class="text-link">Đọc bài viết ↗</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {slug === 'gioi-thieu' && (
        <>
          <section class="container about-teaser">
            <img src={photo('f073dd95d8ed1766').src} srcset={photo('f073dd95d8ed1766').srcSet || undefined} sizes={wideSizes} alt="Vệ Sinh Tino" width="768" height="1024" decoding="async" />
            <div>
              <h2>
                Một góc sạch.<br />Một niềm an tâm.
              </h2>
              <p>
                Tino cung cấp dịch vụ vệ sinh công nghiệp và nhà ở tại TP.HCM, cùng các dịch vụ vệ sinh nhà xưởng, kính tòa nhà, thảm và ghế sofa.
              </p>
              <p>
                Chúng tôi tiếp nhận nhu cầu, khảo sát hiện trạng và thống nhất hạng mục trước khi thực hiện. Thiết bị và phương pháp làm sạch được lựa chọn theo từng công việc.
              </p>
              <a class="button" href="/category/dichvuvesinh/">
                Khám phá dịch vụ ↗
              </a>
            </div>
          </section>

          <section class="container section">
            <div class="section-heading">
              <h2>
                Cẩn thận trong việc làm.<br />Rõ ràng trong trao đổi.
              </h2>
              <p>Uy tín, chất lượng và chuyên nghiệp là những giá trị Tino hướng tới trong quá trình phục vụ.</p>
            </div>
            <TrustCards client:visible />

            <div class="about-fleet-section">
              <div class="section-heading">
                <p class="page-kicker">03 / TRANG THIẾT BỊ &amp; CƠ ĐỘNG</p>
                <h2>
                  Chủ động thiết bị.<br />Có mặt đúng hẹn.
                </h2>
                <p>
                  Thiết bị và dụng cụ được bố trí theo hạng mục, chất liệu và điều kiện tiếp cận của từng công trình. Bạn có thể gửi ảnh hiện trạng để trao đổi trước khi đặt lịch.
                </p>
              </div>
              <div class="about-fleet-grid">
                <figure class="fleet-figure">
                  <img
                    src={photo('7feaeec9c23f86043f45177ee81d9896').src}
                    srcset={photo('7feaeec9c23f86043f45177ee81d9896').srcSet || undefined}
                    sizes={wideSizes}
                    alt="Xe máy cơ động trang bị máy hút bụi công nghiệp và thang nhôm Tino"
                    width="768"
                    height="1024"
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>
                    Thiết bị và dụng cụ được chuẩn bị cho hạng mục vệ sinh
                  </figcaption>
                </figure>
                <figure class="fleet-figure">
                  <img
                    src={photo('b486da45979bde972f03edd7f9a890e5').src}
                    srcset={photo('b486da45979bde972f03edd7f9a890e5').srcSet || undefined}
                    sizes={wideSizes}
                    alt="Đội ngũ kỹ thuật viên Tino làm việc đồng bộ tại công trình"
                    width="768"
                    height="1024"
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>
                    Đội ngũ kỹ thuật viên phối hợp đồng bộ từng hạng mục kính, nội thất và sàn
                  </figcaption>
                </figure>
              </div>
            </div>

            <div class="process-wrap">
              <div class="section-heading">
                <h2>Quy trình chuẩn hóa.</h2>
                <p>4 bước rõ ràng từ tiếp nhận đến nghiệm thu.</p>
              </div>
              <ol class="process-list">
                {steps.map(([n, t, d]) => (
                  <li>
                    <span class="step-circle">{n}</span>
                    <h3>{t}</h3>
                    <p>{d}</p>
                  </li>
                ))}
              </ol>
            </div>

            <div class="about-actions-grid">
              <div class="about-action-card">
                <span class="action-card-tag">CƠ HỘI NGHỀ NGHIỆP</span>
                <h3>Gia nhập đội ngũ Tino</h3>
                <p>
                  Tino luôn chào đón những nhân sự tận tâm, trách nhiệm cùng xây dựng môi trường làm việc chuyên nghiệp, đãi ngộ tốt.
                </p>
                <a class="button light" href="/tuyen-dung/">
                  Xem thông tin tuyển dụng <span aria-hidden="true">↗</span>
                </a>
              </div>
              <div class="about-action-card highlight">
                <span class="action-card-tag">HỖ TRỢ NHANH CHÓNG</span>
                <h3>Cần khảo sát &amp; báo giá?</h3>
                <p>
                  Liên hệ ngay để nhận phương án vệ sinh tối ưu và bảng chi phí chi tiết, minh bạch cho không gian của bạn.
                </p>
                <a class="button" href="/lien-he/">
                  Liên hệ trực tiếp <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </section>
        </>
      )}

      {slug === 'lien-he' && (
        <section class="container contact-page">
          <div class="contact-card">
            <h2>Liên hệ trực tiếp</h2>
            <a class="big-phone" href={'tel:' + contact.phone}>
              {contact.display}
            </a>
            <a class="button" href={contact.zalo} target="_blank" rel="noopener noreferrer">
              Chat với Tino qua Zalo ↗
            </a>
            <a href={'mailto:' + contact.email}>{contact.email}</a>
            <p>Giờ liên hệ: {contact.hours}</p>
            <p>
              Gửi hình ảnh hoặc video hiện trạng qua Zalo để kỹ thuật viên tư vấn phương án và trao đổi báo giá phù hợp.
            </p>
          </div>
          <div class="branch-list">
            <h2>Các điểm liên hệ tại TP.HCM</h2>
            {contact.addresses.map((address, i) => (
              <article>
                <h3>Điểm liên hệ {i + 1}</h3>
                <p>{address}</p>
                <a
                  class="text-link"
                  href={'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(address)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Mở chỉ đường trên bản đồ ↗
                </a>
              </article>
            ))}
          </div>
        </section>
      )}

      {slug === 'tuyen-dung' && (
        <div class="container">
          <section class="recruit-panel">
            <img
              src={photo('3799e45e26386034').src}
                    srcset={photo('3799e45e26386034').srcSet || undefined}
                    sizes={wideSizes}
              alt="Công việc vệ sinh sàn tại Tino"
              width="768"
              height="1024"
              loading="lazy"
              decoding="async"
            />
            <div class="empty-state">
              <p class="page-kicker">LÀM VIỆC CÙNG TINO</p>
              <h2>Quan tâm đến công việc vệ sinh?</h2>
              <p>
                Liên hệ trực tiếp với Tino qua hotline {contact.display} để hỏi về vị trí đang tuyển, khu vực làm việc và yêu cầu công việc. Thông tin tuyển dụng cụ thể sẽ được trao đổi khi liên hệ.
              </p>
              <a class="button" href={'tel:' + contact.phone}>
                Trao đổi về công việc ↗
              </a>
            </div>
          </section>
        </div>
      )}

      {slug !== 'lien-he' && <ContactBand />}
    </>
  )}
</Layout>
