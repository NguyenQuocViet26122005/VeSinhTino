---
import Layout from '../layouts/Layout.astro';
import PriceTable from '../components/PriceTable.astro';
import ContactBand from '../components/ContactBand.astro';
import ServiceList from '../components/ServiceList.astro';
import TrustCards from '../components/TrustCards';
import {services,articles,image,contact,commonPrices,factoryPrices,glassPrices,steps} from '../data/site';
export function getStaticPaths(){return [...services.map(s=>({params:{slug:s.slug},props:{kind:'service',slug:s.slug}})),...articles.map(a=>({params:{slug:a.slug},props:{kind:'article',slug:a.slug}})),...['gioi-thieu','bang-gia','tin-tuc','cam-nang','lien-he','tuyen-dung','category/dichvuvesinh','category/dich-vu-phu','author/vesinhtinogmail-com'].map(slug=>({params:{slug},props:{kind:'page',slug}}))];}
const {slug}=Astro.props;
const service=services.find(s=>s.slug===slug);const article=articles.find(a=>a.slug===slug);
const titles:Record<string,string>={'gioi-thieu':'Chăm chút từng không gian.','bang-gia':'Bảng giá dịch vụ','tin-tuc':'Chuyện chăm nhà.','cam-nang':'Chuyện chăm nhà.','lien-he':'Cùng Tino làm sạch.','tuyen-dung':'Cùng làm việc tại Tino.','category/dichvuvesinh':'Dịch vụ cho không gian của bạn.','category/dich-vu-phu':'Kinh nghiệm vệ sinh','author/vesinhtinogmail-com':'Bài viết từ Tino'};
const title=service?.name||article?.title||titles[slug]||'Vệ Sinh Tino';
const description=service?.description||article?.lead;
const isJournal=['tin-tuc','cam-nang','category/dich-vu-phu','author/vesinhtinogmail-com'].includes(slug);
---
<Layout title={title} description={description}>
{service ? <><section class="container service-hero"><div><nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span>/</span><a href="/category/dichvuvesinh/">Dịch vụ</a></nav><p class="page-kicker">TINO / {service.tag}</p><h1>{service.name}</h1><p>{service.description}</p><a class="button" href={'tel:'+contact.phone}>Trao đổi với Tino <span aria-hidden="true">↗</span></a></div><img src={image(service.photo)} alt={service.name} width="768" height="850" fetchpriority="high" decoding="async"/></section><section class="container section service-body"><article><p class="page-kicker">01 / HẠNG MỤC THỰC HIỆN</p><h2>Chăm sóc đúng cách.</h2><p>{service.intro}</p><ul class="task-list">{service.tasks.map(task=><li>{task}</li>)}</ul><p class="page-kicker">02 / CHI PHÍ MINH BẠCH</p><h2>Đơn giá dịch vụ</h2><PriceTable rows={service.prices} caption={'Bảng giá '+service.name.toLowerCase()}/><p class="price-note">{service.priceNote} Chi phí cụ thể được thống nhất sau khi khảo sát.</p><div class="service-gallery">{service.photos.map(id=><button data-photo={image(id)} data-caption={service.name} aria-label={'Xem ảnh '+service.name.toLowerCase()}><img src={image(id)} alt={service.name} loading="lazy" decoding="async" width="768" height="850"/></button>)}</div></article><aside class="service-sidebar"><h2>Dịch vụ của Tino</h2>{services.map(s=><a href={'/'+s.slug+'/'} aria-current={s.slug===slug?'page':undefined}>{s.name} ↗</a>)}<a class="button" href="/bang-gia/">Xem tất cả bảng giá</a></aside></section><section class="container section related-section"><div class="section-heading"><h2>Rõ ràng từng bước.</h2></div><ol class="process-list">{steps.map(([n,t,d])=><li><span class="step-circle">{n}</span><h3>{t}</h3><p>{d}</p></li>)}</ol></section><ContactBand/></> : article ? <><section class="container page-intro"><nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span>/</span><a href="/cam-nang/">Cẩm nang</a></nav><p class="article-meta">{article.category} · Tino</p><h1>{article.title}</h1><p>{article.lead}</p></section><article class="container article-layout"><div><nav class="article-toc" aria-label="Nội dung bài viết"><strong>Trong bài viết này</strong>{article.sections.map(([heading],i)=><a href={'#noi-dung-'+i}>{heading}<span aria-hidden="true">↗</span></a>)}</nav>{article.sections.map(([heading,body],i)=><section id={'noi-dung-'+i}><h2>{heading}</h2><p>{body}</p></section>)}<a class="text-link" href="/bang-gia/">Tham khảo bảng giá dịch vụ ↗</a><p class="article-meta">Biên tập từ nội dung cẩm nang của Vệ Sinh Tino.</p></div><img src={image(article.photo)} alt={article.title} width="768" height="1024" loading="lazy" decoding="async"/></article><ContactBand/></> : <>
<section class="container page-intro"><nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span>/</span><span>{slug==='bang-gia'?'Bảng giá':slug==='lien-he'?'Liên hệ':slug==='gioi-thieu'?'Về Tino':isJournal?'Cẩm nang':slug==='tuyen-dung'?'Tuyển dụng':'Dịch vụ'}</span></nav><p class="page-kicker">TINO / {slug==='gioi-thieu'?'CÂU CHUYỆN CỦA CHÚNG TÔI':slug==='lien-he'?'BẮT ĐẦU CUỘC TRÒ CHUYỆN':slug==='bang-gia'?'CHI PHÍ MINH BẠCH':isJournal?'CẨM NANG CHĂM NHÀ':slug==='tuyen-dung'?'CÙNG NHAU LÀM TỐT':'CHĂM SÓC KHÔNG GIAN'}</p><h1>{title}</h1>{slug==='bang-gia'&&<p>Đơn giá theo từng hạng mục, diện tích và phương pháp thi công. Tino trao đổi và thống nhất chi phí trước khi thực hiện.</p>}{slug==='category/dichvuvesinh'&&<p>Từ tổ ấm đến nơi làm việc, chọn cách chăm sóc phù hợp với không gian của bạn.</p>}{isJournal&&<p>Những lưu ý thiết thực để chăm sóc nhà cửa và chuẩn bị cho một buổi vệ sinh hiệu quả.</p>}{slug==='lien-he'&&<p>Cho Tino biết diện tích, địa chỉ, hiện trạng và thời gian bạn cần hỗ trợ. Chúng tôi sẽ trao đổi phương án phù hợp.</p>}</section>
{slug==='bang-gia'&&<div class="container"><nav class="price-jump" aria-label="Chọn bảng giá"><a href="#gia-tong-hop">01 / Tổng hợp</a><a href="#gia-nha-xuong">02 / Nhà xưởng</a><a href="#gia-kinh">03 / Kính tòa nhà</a></nav><section id="gia-tong-hop" class="price-block"><h2>Vệ sinh tổng hợp</h2><PriceTable rows={commonPrices} caption="Đơn giá theo hạng mục"/></section><section id="gia-nha-xuong" class="price-block"><h2>Vệ sinh nhà xưởng</h2><PriceTable rows={factoryPrices} caption="Đơn giá theo diện tích nhà xưởng"/></section><section id="gia-kinh" class="price-block"><h2>Vệ sinh kính tòa nhà</h2><PriceTable rows={glassPrices} caption="Đơn giá theo phương pháp thi công"/><p class="price-note">Kính ngoài cao tầng ở bảng tổng hợp ghi “Liên hệ”. Các mức trên là bảng riêng theo phương pháp thi công, không áp dụng đồng loạt cho mọi công trình.</p></section></div>}
{slug==='category/dichvuvesinh'&&<section class="container section"><ServiceList compact/></section>}
{isJournal&&<section class="container section article-journal"><div class="journal-grid">{articles.map(a=><a href={'/'+a.slug+'/'} class="journal-card"><img src={image(a.photo)} alt={a.title} loading="lazy" decoding="async" width="768" height="520"/><span>{a.category}</span><h2 style="font-size:23px;margin:10px 0">{a.title}</h2><span class="text-link">Đọc bài viết ↗</span></a>)}</div></section>}
{slug==='gioi-thieu'&&<><section class="container about-teaser"><img src={image('f073dd95d8ed1766')} alt="Vệ Sinh Tino" width="768" height="1024" decoding="async"/><div><h2>Một góc sạch.<br/>Một niềm an tâm.</h2><p>Tino cung cấp dịch vụ vệ sinh công nghiệp và nhà ở tại TP.HCM, cùng các dịch vụ vệ sinh nhà xưởng, kính tòa nhà, thảm và ghế sofa.</p><p>Chúng tôi tiếp nhận nhu cầu, khảo sát hiện trạng và thống nhất hạng mục trước khi thực hiện. Thiết bị và phương pháp làm sạch được lựa chọn theo từng công việc.</p><a class="button" href="/category/dichvuvesinh/">Khám phá dịch vụ ↗</a></div></section><section class="container section"><div class="section-heading"><h2>Cẩn thận trong việc làm.<br/>Rõ ràng trong trao đổi.</h2><p>Uy tín, chất lượng và chuyên nghiệp là những giá trị Tino hướng tới trong quá trình phục vụ.</p></div><TrustCards client:visible/><div class="about-fleet-section"><div class="section-heading"><p class="page-kicker">03 / TRANG THIẾT BỊ &amp; CƠ ĐỘNG</p><h2>Chủ động thiết bị.<br/>Có mặt đúng hẹn.</h2><p>Mỗi tổ thi công Tino đều được trang bị xe máy cơ động kèm máy hút bụi 3 motor, thang nhôm chữ A và bộ hóa chất sinh học chuyên dụng, sẵn sàng phục vụ nhanh chóng khắp mọi ngõ hẻm và quận huyện TP.HCM.</p></div><div class="about-fleet-grid"><figure class="fleet-figure"><img src={image('7feaeec9c23f86043f45177ee81d9896')} alt="Xe máy cơ động trang bị máy hút bụi công nghiệp và thang nhôm Tino" width="768" height="1024" loading="lazy" decoding="async"/><figcaption>Xe cơ động chở máy hút bụi 3 motor và thang nhôm sẵn sàng lên đường tới công trình</figcaption></figure><figure class="fleet-figure"><img src={image('b486da45979bde972f03edd7f9a890e5')} alt="Đội ngũ kỹ thuật viên Tino làm việc đồng bộ tại công trình" width="768" height="1024" loading="lazy" decoding="async"/><figcaption>Đội ngũ kỹ thuật viên phối hợp đồng bộ từng hạng mục kính, nội thất và sàn</figcaption></figure></div></div><div class="process-wrap"><div class="section-heading"><h2>Quy trình chuẩn hóa.</h2><p>4 bước rõ ràng từ tiếp nhận đến nghiệm thu.</p></div><ol class="process-list">{steps.map(([n,t,d])=><li><span class="step-circle">{n}</span><h3>{t}</h3><p>{d}</p></li>)}</ol></div><div class="about-actions-grid"><div class="about-action-card"><span class="action-card-tag">CƠ HỘI NGHỀ NGHIỆP</span><h3>Gia nhập đội ngũ Tino</h3><p>Tino luôn chào đón những nhân sự tận tâm, trách nhiệm cùng xây dựng môi trường làm việc chuyên nghiệp, đãi ngộ tốt.</p><a class="button light" href="/tuyen-dung/">Xem thông tin tuyển dụng <span aria-hidden="true">↗</span></a></div><div class="about-action-card highlight"><span class="action-card-tag">HỖ TRỢ NHANH CHÓNG</span><h3>Cần khảo sát &amp; báo giá?</h3><p>Liên hệ ngay để nhận phương án vệ sinh tối ưu và bảng chi phí chi tiết, minh bạch cho không gian của bạn.</p><a class="button" href="/lien-he/">Liên hệ trực tiếp <span aria-hidden="true">↗</span></a></div></div></section></>}
{slug==='lien-he'&&<section class="container contact-page"><div class="contact-card"><h2>Liên hệ trực tiếp</h2><a class="big-phone" href={'tel:'+contact.phone}>{contact.display}</a><a class="button" href={contact.zalo} target="_blank" rel="noopener noreferrer">Chat với Tino qua Zalo ↗</a><a href={'mailto:'+contact.email}>{contact.email}</a><p>Giờ liên hệ: {contact.hours}</p><p>Gửi hình ảnh hiện trạng qua Zalo để việc trao đổi nhu cầu được thuận tiện hơn.</p></div><div class="branch-list"><h2>Các địa chỉ liên hệ</h2>{contact.addresses.map((address,i)=><article><h3>Chi nhánh {i+1}</h3><p>{address}</p><a class="text-link" href={'https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(address)} target="_blank" rel="noopener noreferrer">Mở bản đồ ↗</a></article>)}</div></section>}
{slug==='tuyen-dung'&&<div class="container"><section class="recruit-panel"><img src={image('3799e45e26386034')} alt="Công việc vệ sinh sàn tại Tino" width="768" height="1024" loading="lazy" decoding="async"/><div class="empty-state"><p class="page-kicker">LÀM VIỆC CÙNG TINO</p><h2>Quan tâm đến công việc vệ sinh?</h2><p>Liên hệ trực tiếp với Tino để hỏi về vị trí đang tuyển, khu vực làm việc và yêu cầu công việc. Thông tin tuyển dụng cụ thể sẽ được trao đổi khi liên hệ.</p><a class="button" href={'tel:'+contact.phone}>Trao đổi về công việc ↗</a></div></section></div>}
{slug!=='lien-he'&&<ContactBand/>}
</>}
</Layout>
