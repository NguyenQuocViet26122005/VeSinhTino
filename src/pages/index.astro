---
import Layout from '../layouts/Layout.astro';
import PriceTable from '../components/PriceTable.astro';
import QuestionFigure from '../components/QuestionFigure';
import AuthenticShowcase from '../components/AuthenticShowcase';
import TrustCards from '../components/TrustCards';
import { image, commonPrices, contact, steps, faqs, services } from '../data/site';
import '../styles/wow.css';
---

<Layout home title="Dịch vụ vệ sinh nhà ở & công nghiệp tại TP.HCM">
  <!-- Scene 1: Spatial Opening with Squeegee Wipe & Daylight -->
  <section class="wow-hero" aria-labelledby="hero-title">
    <div class="daylight-field" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="hero-gridline" aria-hidden="true"></div>

    <div class="wow-hero-copy">
      <p class="wow-location"><span></span> Vệ sinh nhà ở & công nghiệp · TP.HCM</p>
      <h1 id="hero-title">
        <span class="hero-word">Sạch<span class="hero-period">.</span></span>
        <span class="hero-line">để sống nhẹ.</span>
      </h1>
      <p class="wow-hero-description">
        Không gian sạch hơn.<br/>
        Thêm thời gian cho điều bạn yêu.
      </p>
      <div class="hero-actions">
        <a class="wow-button" href="/lien-he/">
          <span>Nhận báo giá</span>
          <span class="cta-disc" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </a>
        <a href="#dich-vu" class="hero-secondary-link">Khám phá 6 dịch vụ <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class="glass-world">
      <div class="world-orbit" aria-hidden="true"></div>
      <div class="window-perspective">
        <div class="window-scene">
          <img
            class="window-photo"
            src={image('3b21a7ec444d0b39')}
            alt="Căn hộ từ thư viện ảnh thực tế của Tino"
            width="768"
            height="1024"
            fetchpriority="high"
            decoding="async"
          />
          <div class="window-haze" aria-hidden="true">
            <div class="haze-grain"></div>
            {Array.from({ length: 18 }, (_, i) => (
              <i
                class="water-drop"
                style={`left:${12 + (i * 31) % 77}%;top:${8 + (i * 17) % 84}%;transform:rotate(${i % 2 ? 22 : -15}deg)`}
              />
            ))}
          </div>
          <div class="window-shine" aria-hidden="true"></div>
          <div class="window-edge" aria-hidden="true"></div>
          <div class="hero-squeegee" aria-hidden="true">
            <div class="squeegee-blade"></div>
            <div class="squeegee-metal"></div>
            <div class="squeegee-neck"></div>
            <div class="squeegee-grip"><span>TINO</span></div>
          </div>
          <div
            class="glass-touch"
            role="slider"
            tabindex="0"
            aria-label="Kéo ngang trên kính để lau"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="35"
            aria-describedby="glass-instruction"
          ></div>
          <span class="glass-instruction" id="glass-instruction">↔ Kéo trên kính để lau</span>
          <span class="window-caption">Ảnh thực tế từ Tino</span>
        </div>
      </div>
      <div class="glass-caption">
        <span>Một đường lau.<br/><strong>Một khác biệt.</strong></span>
        <span class="glass-mark" aria-hidden="true">✳</span>
      </div>
    </div>

    <div class="hero-bottom">
      <div class="wipe-control">
        <label for="hero-wipe">
          <span id="wipe-label">Thử lau kính</span>
          <output id="wipe-readout" aria-live="off">35%</output>
        </label>
        <input id="hero-wipe" type="range" min="0" max="100" value="35" aria-label="Điều chỉnh đường lau kính"/>
        <div class="wipe-actions">
          <span id="wipe-status" role="status" aria-live="polite">Mở ra một góc nhìn mới.</span>
          <button type="button" id="wipe-reset">Lau lại <span class="reset-spin" aria-hidden="true">↺</span></button>
        </div>
        <span>Mô phỏng trên ảnh, không phải ảnh trước và sau.</span>
      </div>
    </div>
  </section>

  <!-- Scene 2: Quiet Promise with authentic Tino philosophy -->
  <section class="wow-intro container">
    <p>ĐỂ VIỆC DỌN DẸP LẠI CHO TINO</p>
    <h2>Bạn có nhiều điều<br/>đáng dành <span>thời gian hơn.</span></h2>
    <div>
      <span class="intro-asterisk" aria-hidden="true">✳</span>
      <p>
        Một buổi sáng thảnh thơi. Một căn nhà dễ chịu. Một nơi làm việc gọn gàng.
        Tino kết hợp máy móc hiện đại cùng hóa chất sinh học an toàn, chăm chút từng góc nhỏ để bạn an tâm tận hưởng không gian của mình.
      </p>
    </div>
    <TrustCards client:visible />
  </section>

  <!-- Scene 3: Interactive Service Showroom -->
  <section id="dich-vu" class="wow-services container">
    <div class="wow-section-top">
      <h2>Không gian của bạn.<br/><span>Cách chăm sóc của Tino.</span></h2>
      <p>Chọn dịch vụ để khám phá.</p>
    </div>
    <div class="service-showroom">
      <div class="service-display">
        {services.map((s, i) => (
          <div class="service-scene" data-service-scene={i} hidden={i !== 0}>
            <img src={image(s.photo)} alt={s.name} width="768" height="850" loading="lazy" decoding="async" />
            <div>
              <span>{s.tag}</span>
              <p>{s.description}</p>
              <a href={'/' + s.slug + '/'}>Xem dịch vụ <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        ))}
      </div>
      <div class="service-index" role="group" aria-label="Chọn dịch vụ">
        {services.map((s, i) => (
          <div class:list={['service-index-row', { 'is-active': i === 0 }]}>
            <button data-service-select={i} aria-pressed={i === 0}>
              <span class="service-index-no">{'0' + (i + 1)}</span>
              <span>{s.name}</span>
              <span class="service-index-symbol" aria-hidden="true">+</span>
            </button>
            <a href={'/' + s.slug + '/'} aria-label={'Xem ' + s.name.toLowerCase()}>↗</a>
          </div>
        ))}
        <p class="service-index-note">
          Từ tổ ấm đến công trình.<br/>
          Một đội ngũ, nhiều giải pháp làm sạch.
        </p>
      </div>
    </div>
  </section>

  <!-- Scene 4: Real Work Photographic Gallery -->
  <section class="wow-work">
    <div class="container">
      <div class="wow-work-heading">
        <div class="wow-work-title-group">
          <span>CHĂM CHÚT TỪNG CHI TIẾT</span>
          <h2>Làm thật.<br/><em>Sạch thật.</em></h2>
        </div>
        <p>100% hình ảnh thực tế từ các công trình thi công & bàn giao của đội ngũ Vệ Sinh Tino tại TP.HCM.</p>
      </div>
      <AuthenticShowcase client:visible />
    </div>
  </section>

  <!-- Scene 5: Transparent Pricing -->
  <section id="bang-gia" class="wow-pricing container">
    <div class="price-heading">
      <p>MINH BẠCH NGAY TỪ ĐẦU</p>
      <h2>Sạch sẽ.<br/><span>Rõ ràng.</span></h2>
      <p>Hạng mục rõ. Chi phí rõ.<br/>Thống nhất trước khi bắt đầu.</p>
      <a class="wow-inline-link" href="/bang-gia/">Tất cả bảng giá <span aria-hidden="true">↗</span></a>
    </div>
    <div class="price-content">
      <p class="mobile-table-note">Vuốt ngang để xem đủ bảng giá →</p>
      <PriceTable rows={commonPrices} caption="Bảng giá dịch vụ vệ sinh tổng hợp"/>
      <p class="price-note">
        Đơn giá theo bảng công bố của Tino. Chi phí cụ thể được thống nhất sau khi trao đổi và khảo sát.
      </p>
    </div>
  </section>

  <!-- Scene 6: Process & FAQ -->
  <section class="wow-process container">
    <h2>Nhẹ nhàng.<br/>Từ đầu đến cuối.</h2>
    <ol>
      {steps.map(([number, title, description]) => (
        <li>
          <span>{number}</span>
          <div>
            <h3>{title}</h3>
            <p>{description}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section container faq-section">
    <div>
      <h2>Còn điều gì<br/>bạn băn khoăn?</h2>
      <QuestionFigure client:visible/>
      <a class="text-link" href={'tel:' + contact.phone}>{contact.display} ↗</a>
    </div>
    <div class="faq-list">
      {faqs.map(([q, a]) => (
        <details>
          <summary>{q}<span aria-hidden="true">+</span></summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Scene 7: Decisive Contact Close -->
  <section class="wow-close">
    <div class="container">
      <p>MỘT KHÔNG GIAN MỚI BẮT ĐẦU TỪ ĐÂY</p>
      <h2>Bạn nghỉ ngơi.<br/>Tino lo phần còn lại.</h2>
      <div class="close-actions">
        <a class="wow-button" href="/lien-he/">
          <span>Nhận báo giá</span>
          <span class="cta-disc" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </a>
        <a class="close-phone" href={'tel:' + contact.phone}>{contact.display} ↗</a>
      </div>
      <div class="close-sublinks">
        <a href="/tuyen-dung/">Gia nhập đội ngũ Tino · Tuyển dụng ↗</a>
        <span aria-hidden="true">·</span>
        <a href="/gioi-thieu/">Tìm hiểu câu chuyện của Tino ↗</a>
      </div>
      <div class="close-wordmark" aria-hidden="true">Tino<span>✳</span></div>
    </div>
  </section>

  <script src="../scripts/wow.ts"></script>
</Layout>
