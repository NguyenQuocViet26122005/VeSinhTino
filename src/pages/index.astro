---
import Layout from '../layouts/Layout.astro';
import { Image, getImage } from 'astro:assets';
import heroPhoto from '../../public/images/3b21a7ec444d0b39.webp';
import PriceTable from '../components/PriceTable.astro';
import QuestionFigure from '../components/QuestionFigure';
import AuthenticShowcase, { PROJECTS } from '../components/AuthenticShowcase';
import TrustCards from '../components/TrustCards';
import ServiceExplorer, { SERVICES_DATA } from '../components/ServiceExplorer';
import CostEstimator from '../components/CostEstimator';
import ContactForm from '../components/ContactForm';
import { commonPrices, apartmentPrices, contact, steps, faqs } from '../data/site';
import '../styles/wow.css';
import { responsiveImages } from '../lib/responsive-images';
import { getLocalBusinessSchemas, getFaqSchema, SITE_URL } from '../lib/seo-schema';

const homeSchema = [...getLocalBusinessSchemas(), getFaqSchema(faqs as [string, string][], `${SITE_URL}/`)];

const projectImages = await responsiveImages(PROJECTS.map(project => project.image));
const serviceImages = await responsiveImages(SERVICES_DATA.map(service => service.photo));
const heroWidths = [320, 480, 640, 768, 960, 1200, 1582];
const heroSizes = '(max-width: 370px) 220px, (max-width: 600px) 252px, (max-width: 1000px) 300px, (max-width: 1100px) 41vw, (max-width: 1599px) 38vw, 560px';
const heroAvif = await getImage({ src: heroPhoto, width: 768, height: 1024, widths: heroWidths.filter(width => width < heroPhoto.width), format: 'avif', quality: 60 });
// Keep extra detail at native resolution on high-density desktop screens.
const heroAvifFull = await getImage({ src: heroPhoto, width: heroPhoto.width, height: heroPhoto.height, format: 'avif', quality: 65 });
const heroAvifSrcset = `${heroAvif.srcSet.attribute}, ${heroAvifFull.src} ${heroPhoto.width}w`;
---

<Layout home schema={homeSchema} title="Vệ sinh công nghiệp & nhà ở tại TP.HCM" description="Tổng vệ sinh công nghiệp tại TP.HCM: văn phòng, trường học, khách sạn, nhà xưởng, kính tòa nhà, nhà sau xây dựng. Khảo sát báo giá: 0925 649 666.">
  <!-- The inline stylesheet is large: announce the hero photo before the browser has to reach its <img>. -->
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={heroAvifSrcset} imagesizes={heroSizes} fetchpriority="high"/>
  <!-- Scene 1: Spatial Opening with Squeegee Wipe & Daylight -->
  <section class="wow-hero" aria-labelledby="hero-title">
    <div class="daylight-field" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="hero-gridline" aria-hidden="true"></div>

    <div class="wow-hero-copy">
      <h1 id="hero-title">
        <span class="hero-word">Sạch<span class="hero-period">.</span></span>
        <span class="hero-line">Vệ sinh công nghiệp & nhà ở tại TP.HCM.</span>
      </h1>
      <p class="wow-hero-description">
        Tổng vệ sinh văn phòng, trường học, khách sạn, nhà xưởng, kính tòa nhà.<br/>
        Vệ sinh sau xây dựng. Khảo sát báo giá theo hiện trạng.
      </p>
      <div class="hero-actions">
        <a class="wow-button" href="#uoc-tinh-chi-phi">
          <span>Ước tính chi phí</span>
          <span class="cta-disc" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </a>
        <a href="#cong-trinh" class="hero-secondary-link">Xem công trình thực tế <span aria-hidden="true">↓</span></a>
      </div>
      <nav class="hero-intents" aria-label="Chọn nhanh dịch vụ">
        <a href="/dich-vu-ve-sinh-cong-nghiep/">Vệ sinh công nghiệp</a>
        <a href="/ve-sinh-nha-o/">Vệ sinh nhà ở</a>
        <a href="/bang-gia/">Bảng giá tham khảo</a>
      </nav>
    </div>

    <div class="glass-world">
      <div class="world-orbit" aria-hidden="true"></div>
      <div class="window-perspective">
        <div class="window-scene">
          <picture>
          <source type="image/avif" srcset={heroAvifSrcset} sizes={heroSizes}/>
          <Image
            class="window-photo"
            src={heroPhoto}
            widths={heroWidths}
            sizes={heroSizes}
            format="webp"
            quality={82}
            alt="Căn hộ từ thư viện ảnh thực tế của Tino"
            width="768"
            height="1024"
            priority
            decoding="async"
          />
          </picture>
          <div class="window-haze" aria-hidden="true">
            <div class="haze-grain"></div>
            {Array.from({ length: 18 }, (_, i) => (
              <i
                class="water-drop"
                style={`left:${12 + (i * 31) % 77}%;top:${8 + (i * 17) % 84}%;transform:rotate(${i % 2 ? 22 : -15}deg)`}
              />
            ))}
          </div>
          <div class="window-shine" aria-hidden="true"></div>
          <div class="window-edge" aria-hidden="true"></div>
          <div class="hero-squeegee" aria-hidden="true">
            <div class="squeegee-blade"></div>
            <div class="squeegee-metal"></div>
            <div class="squeegee-neck"></div>
            <div class="squeegee-grip"><span>TINO</span></div>
          </div>
          <div
            class="glass-touch"
            role="slider"
            tabindex="0"
            aria-label="Kéo ngang trên kính để lau"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="35"
            aria-describedby="glass-instruction"
          ></div>
          <span class="glass-instruction" id="glass-instruction">↔ Kéo trên kính để lau</span>
          <span class="window-caption">Ảnh thực tế từ Tino</span>
        </div>
      </div>
      <div class="glass-caption">
        <span>Một đường lau.<br/><strong>Một khác biệt.</strong></span>
        <span class="glass-mark" aria-hidden="true">✳</span>
      </div>
    </div>

    <div class="hero-bottom">
      <div class="wipe-control">
        <label for="hero-wipe">
          <span id="wipe-label">Thử lau kính</span>
          <output id="wipe-readout" aria-live="off">35%</output>
        </label>
        <input id="hero-wipe" type="range" min="0" max="100" value="35" aria-label="Điều chỉnh đường lau kính"/>
        <div class="wipe-actions">
          <span id="wipe-status" role="status" aria-live="polite">Mở ra một góc nhìn mới.</span>
          <button type="button" id="wipe-reset">Lau lại <span class="reset-spin" aria-hidden="true">↺</span></button>
        </div>
        <span>Mô phỏng trên ảnh, không phải ảnh trước và sau.</span>
      </div>
    </div>
  </section>

  <!-- Scene 2: Quiet Promise with authentic Tino philosophy -->
  <section class="wow-intro container">
    <p>ĐỂ VIỆC DỌN DẸP LẠI CHO TINO</p>
    <h2>Bạn có nhiều điều đáng dành <span>thời gian hơn.</span></h2>
    <div>
      <span class="intro-asterisk" aria-hidden="true">✳</span>
      <p>
        Một buổi sáng thảnh thơi. Một căn nhà dễ chịu. Một nơi làm việc gọn gàng.
        Đội vệ sinh nhiều năm trong nghề của Tino làm việc với trang thiết bị hiện đại cùng hóa chất chuyên dụng phù hợp, chăm chút từng góc nhỏ để bạn an tâm tận hưởng không gian của mình.
      </p>
    </div>
    <TrustCards client:visible />
  </section>

  <!-- Scene 3 (Section A): Chọn đúng nhu cầu ("Bạn cần làm sạch không gian nào?") -->
  <section id="dich-vu" class="wow-services container">
    <div class="wow-section-top">
      <h2>Bạn cần làm sạch <span>không gian nào?</span></h2>
      <p>Chọn dịch vụ để xem mô tả ngắn, phạm vi công việc và đơn giá tham khảo.</p>
    </div>
    <ServiceExplorer client:visible={{ rootMargin: '600px' }} images={serviceImages} />
  </section>

  <!-- Scene 4 (Section B): Công trình thực tế — Điểm "WOW" thứ 2 -->
  <section class="wow-work">
    <div class="container">
      <div class="wow-work-heading">
        <div class="wow-work-title-group">
          <span>CHĂM CHÚT TỪNG CHI TIẾT</span>
          <h2>Làm thật.<br/><em>Sạch thật.</em></h2>
        </div>
        <p>Hình ảnh từ thư viện công trình của Vệ Sinh Tino. Chọn ảnh để xem và trao đổi về hạng mục bạn cần.</p>
      </div>
      <AuthenticShowcase client:visible images={projectImages} />
    </div>
  </section>

  <!-- Scene 5 (Section C): Chi phí minh bạch & Công cụ ước tính -->
  <section id="bang-gia" class="wow-pricing container">
    <div class="price-heading">
      <p>MINH BẠCH NGAY TỪ ĐẦU</p>
      <h2>Sạch sẽ.<br/><span>Rõ ràng.</span></h2>
      <p>Hạng mục rõ. Chi phí rõ.<br/>Thống nhất trước khi bắt đầu.</p>
      <a class="wow-inline-link" href="/bang-gia/">Tất cả bảng giá chi tiết <span aria-hidden="true">↗</span></a>
    </div>
    <div class="price-content">
      <!-- Interactive Estimator -->
      <CostEstimator client:visible={{ rootMargin: '600px' }} />

      <!-- Dedicated Apartment Package Table -->
      <div style="margin-top: 40px;">
        <p class="mobile-table-note">Vuốt ngang để xem đủ bảng giá chung cư →</p>
        <PriceTable rows={apartmentPrices} caption="Bảng giá tổng vệ sinh chung cư trọn gói"/>
        <p class="price-note">
          Gói tổng vệ sinh chung cư trọn gói căn 50m² từ 1.600.000 đ. Đơn giá tham khảo đã bao gồm nhân công, máy móc chuyên dụng và hóa chất làm sạch phù hợp.
        </p>
      </div>

      <!-- Full Reference Table -->
      <div style="margin-top: 45px;">
        <p class="mobile-table-note">Vuốt ngang để xem đủ bảng giá tổng hợp →</p>
        <PriceTable rows={commonPrices} caption="Bảng giá dịch vụ vệ sinh tổng hợp"/>
        <p class="price-note">
          Đơn giá theo bảng công bố của Tino. Chi phí cụ thể được thống nhất sau khi trao đổi và khảo sát hiện trạng.
        </p>
      </div>
    </div>
  </section>

  <!-- Scene 6 (Section D): Quy trình 4 bước chuẩn hóa -->
  <section class="wow-process container">
    <div class="wow-section-top">
      <h2>Nhẹ nhàng. <span>Từ đầu đến cuối.</span></h2>
      <p>4 bước làm việc chuẩn mực — Khách hàng kiểm tra nghiệm thu trước khi thanh toán.</p>
    </div>
    <ol>
      {steps.map(([number, title, description]) => (
        <li>
          <span>{number}</span>
          <div>
            <h3>{title}</h3>
            <p>{description}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Scene 6.5: Khu vực phục vụ tại TP.HCM & Điểm liên hệ thực tế -->
  <section class="wow-locations container" aria-labelledby="locations-title">
    <div class="wow-section-top">
      <p class="page-kicker">ĐỊA BÀN PHỤC VỤ &amp; CƠ ĐỘNG</p>
      <h2 id="locations-title">Vệ sinh tại TP.HCM. <span>Trao đổi trước khi đặt lịch.</span></h2>
      <p>Thông tin liên hệ tại Quận 12, Phú Nhuận và Quận 7. Gửi khu vực, diện tích và ảnh hiện trạng để trao đổi phạm vi công việc cùng lịch thực hiện.</p>
    </div>
    <div class="locations-grid">
      <div class="location-card">
        <span class="location-zone">BẮC SÀI GÒN</span>
        <h3>Quận 12 &amp; Khu vực lân cận</h3>
        <p class="location-addr">557 Tô Ký, Phường Trung Mỹ Tây, Quận 12</p>
        <p class="location-desc">Gửi vị trí công trình tại Quận 12 hoặc khu vực lân cận để trao đổi lịch và phương án vệ sinh.</p>
        <a class="location-map-link" href={'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('557 Tô Ký, Trung Mỹ Tây, Quận 12, TP.HCM')} target="_blank" rel="noopener noreferrer">
          Chỉ đường trên Maps ↗
        </a>
      </div>
      <div class="location-card">
        <span class="location-zone">TRUNG TÂM</span>
        <h3>Phú Nhuận &amp; Nội thành</h3>
        <p class="location-addr">151 Nguyễn Đình Chính, Phường 11, Phú Nhuận</p>
        <p class="location-desc">Trao đổi địa chỉ, diện tích và hạng mục cần làm trước khi thống nhất báo giá, lịch thực hiện.</p>
        <a class="location-map-link" href={'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('151 Nguyễn Đình Chính, Phường 11, Phú Nhuận, TP.HCM')} target="_blank" rel="noopener noreferrer">
          Chỉ đường trên Maps ↗
        </a>
      </div>
      <div class="location-card">
        <span class="location-zone">NAM SÀI GÒN</span>
        <h3>Quận 7 &amp; Khu đô thị</h3>
        <p class="location-addr">37B Nguyễn Văn Linh, Tân Thuận Tây, Quận 7</p>
        <p class="location-desc">Mô tả nhà ở, căn hộ hoặc công trình tại Quận 7 và khu vực lân cận để Tino tiếp nhận nhu cầu cụ thể.</p>
        <a class="location-map-link" href={'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('37B Nguyễn Văn Linh, Tân Thuận Tây, Quận 7, TP.HCM')} target="_blank" rel="noopener noreferrer">
          Chỉ đường trên Maps ↗
        </a>
      </div>
    </div>
  </section>

  <!-- Scene 7 (Section E): Gỡ bỏ băn khoăn trước khi liên hệ (FAQ) -->
  <section class="section container faq-section">
    <div>
      <h2>Còn điều gì bạn băn khoăn?</h2>
      <QuestionFigure client:visible/>
      <a class="text-link" href={'tel:' + contact.phone}>Hotline tư vấn: {contact.display} ↗</a>
    </div>
    <div class="faq-list">
      {faqs.map(([q, a]) => (
        <details>
          <summary>{q}<span aria-hidden="true">+</span></summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Scene 8 (Section F): Liên hệ thuận tiện -->
  <section id="lien-he-tu-van" class="wow-contact-section container">
    <ContactForm client:visible={{ rootMargin: '600px' }} />
  </section>

  <!-- Scene 9: Decisive Contact Close -->
  <section class="wow-close">
    <div class="container">
      <p>MỘT KHÔNG GIAN MỚI BẮT ĐẦU TỪ ĐÂY</p>
      <h2>Bạn nghỉ ngơi. Tino lo phần còn lại.</h2>
      <div class="close-actions">
        <a class="wow-button" href="#lien-he-tu-van">
          <span>Nhận báo giá ngay</span>
          <span class="cta-disc" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </a>
        <a class="close-phone" href={'tel:' + contact.phone}>{contact.display} ↗</a>
      </div>
      <div class="close-sublinks">
        <a href="/tuyen-dung/">Gia nhập đội ngũ Tino · Tuyển dụng ↗</a>
        <span aria-hidden="true">·</span>
        <a href="/gioi-thieu/">Tìm hiểu câu chuyện của Tino ↗</a>
      </div>
      <div class="close-wordmark" aria-hidden="true">Tino<span>✳</span></div>
    </div>
  </section>

  <script src="../scripts/wow.ts"></script>
</Layout>
