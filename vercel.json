{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/tin-tuc", "destination": "/cam-nang/", "permanent": true },
    { "source": "/tin-tuc/", "destination": "/cam-nang/", "permanent": true },
    { "source": "/category/dich-vu-phu", "destination": "/cam-nang/", "permanent": true },
    { "source": "/category/dich-vu-phu/", "destination": "/cam-nang/", "permanent": true },
    { "source": "/author/vesinhtinogmail-com", "destination": "/cam-nang/", "permanent": true },
    { "source": "/author/vesinhtinogmail-com/", "destination": "/cam-nang/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" }
      ]
    },
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
